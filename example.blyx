use budgetleft;

fn main() {
    let bad = 7.0;
    let total = 100.0;
    let allowance = 0.05;
    let result = budgetleft_events(bad, total, allowance);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
